{
  "components": {
    "responses": {
      "BadRequest": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "The request body could not be read."
      },
      "Error": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Any other error."
      },
      "Forbidden": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "The credentials do not allow this request."
      },
      "Invalid": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "The input failed validation; errors names the fields."
      },
      "Unauthorized": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "The request has no valid credentials."
      }
    },
    "schemas": {
      "Color": {
        "description": "Color is the colour of an item.",
        "enum": [
          "red",
          "blue"
        ],
        "type": "string"
      },
      "FieldError": {
        "properties": {
          "field": {
            "description": "Path in the input, with dots and indices: items.2.sku.",
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "rule": {
            "description": "The rule that failed; missing for errors written by a handler.",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "type": "object"
      },
      "Grade": {
        "enum": [
          "a",
          "b"
        ],
        "type": "string"
      },
      "Item": {
        "description": "Item is what the API returns.",
        "properties": {
          "attrs": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "big": {
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "data": {},
          "id": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/Kind"
          },
          "price": {
            "type": "number"
          },
          "stock": {
            "format": "int32",
            "type": "integer"
          },
          "updated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "price",
          "stock",
          "big",
          "attrs",
          "created_at"
        ],
        "type": "object"
      },
      "ItemInput": {
        "additionalProperties": false,
        "description": "ItemInput creates an item.",
        "properties": {
          "color": {
            "$ref": "#/components/schemas/Color"
          },
          "contact": {
            "additionalProperties": false,
            "properties": {
              "email": {
                "format": "email",
                "type": "string"
              },
              "site": {
                "format": "uri",
                "type": "string"
              }
            },
            "type": "object"
          },
          "count": {
            "maximum": 100,
            "type": "integer"
          },
          "ean": {
            "description": "The server also checks it with the rule ean13.",
            "type": "string"
          },
          "grade": {
            "$ref": "#/components/schemas/Grade"
          },
          "kind": {
            "$ref": "#/components/schemas/Kind",
            "minLength": 1,
            "pattern": "\\S"
          },
          "labels": {
            "additionalProperties": {
              "maxLength": 40,
              "type": "string"
            },
            "type": "object"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/Line"
            },
            "minItems": 1,
            "type": "array"
          },
          "parent": {
            "anyOf": [
              {
                "format": "itemID",
                "pattern": "^(?:[0-9a-f]{8})$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "price": {
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Required when kind is product."
          },
          "size": {
            "enum": [
              "s",
              "m",
              "l"
            ],
            "type": "string"
          },
          "sku": {
            "description": "SKU identifies the item.",
            "examples": [
              "ABC-1234"
            ],
            "minLength": 1,
            "pattern": "^(?:[A-Z]{3}-[0-9]{4})$",
            "type": "string"
          },
          "stock": {
            "additionalProperties": {
              "format": "int64",
              "type": "integer"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/Kind"
            },
            "type": "object"
          }
        },
        "required": [
          "sku",
          "kind"
        ],
        "type": "object"
      },
      "Kind": {
        "description": "Kind is the kind of an item.",
        "enum": [
          "",
          "product",
          "service"
        ],
        "type": "string"
      },
      "Line": {
        "additionalProperties": false,
        "description": "Line is one line of an item.",
        "properties": {
          "child": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Line"
              },
              {
                "type": "null"
              }
            ]
          },
          "qty": {
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "text": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "type": "object"
      },
      "Opening": {
        "additionalProperties": false,
        "description": "Opening is one opening time. Inside a PUT input it is complete too.",
        "properties": {
          "day": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "hours": {
            "type": "string"
          }
        },
        "required": [
          "day",
          "hours"
        ],
        "type": "object"
      },
      "Page_Item": {
        "description": "Page is one page of a list.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "type": "array"
          },
          "total": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total"
        ],
        "type": "object"
      },
      "Problem": {
        "description": "RFC 9457 problem details.",
        "properties": {
          "code": {
            "description": "The case of a problem the client can react to.",
            "oneOf": [
              {
                "const": "itemLocked",
                "description": "Status 423. The item is locked."
              },
              {
                "const": "soldOut",
                "description": "Status 409. ErrSoldOut: the item cannot be ordered now. The client recognises it\nwith isSoldOut."
              }
            ],
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array"
          },
          "instance": {
            "description": "Names a server error; the server's log has the same instance with the cause.",
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "type": "object"
      },
      "Settings": {
        "additionalProperties": false,
        "description": "Settings are replaced as a whole with PUT, so every field must be sent,\nin TypeScript and to the server.",
        "properties": {
          "hours": {
            "items": {
              "$ref": "#/components/schemas/Opening"
            },
            "type": "array"
          },
          "labels": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "logo": {
            "description": "Logo may be left out, and then stays as it is.",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "notes",
          "hours",
          "labels"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "Key": {
        "description": "Key is the key of another system.",
        "scheme": "bearer",
        "type": "http"
      },
      "Session": {
        "description": "Session is the sign-in of the browser.",
        "in": "cookie",
        "name": "session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "Features",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/items": {
      "get": {
        "operationId": "list",
        "parameters": [
          {
            "in": "query",
            "name": "kind",
            "schema": {
              "$ref": "#/components/schemas/Kind"
            }
          },
          {
            "in": "query",
            "name": "tags",
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "since",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "anyOf": [
                {
                  "format": "int64",
                  "maximum": 100,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_Item"
                }
              }
            },
            "description": "OK"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [],
        "summary": "List returns a page of items."
      },
      "post": {
        "operationId": "createItem",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ItemInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/Item"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "description": "Created"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "Session": []
          }
        ],
        "summary": "CreateItem adds an item."
      }
    },
    "/api/items/{id}/archive": {
      "patch": {
        "operationId": "archive",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "itemID",
              "pattern": "^(?:[0-9a-f]{8})$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "Session": [
              "admin"
            ]
          }
        ],
        "summary": "Archive archives an item."
      }
    },
    "/api/items/{id}/image": {
      "post": {
        "operationId": "uploadImage",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "itemID",
              "pattern": "^(?:[0-9a-f]{8})$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file": {
                    "format": "binary",
                    "type": "string"
                  }
                },
                "required": [
                  "file"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            },
            "description": "Created"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "Session": []
          }
        ],
        "summary": "UploadImage stores an image for an item."
      }
    },
    "/api/items/{id}/sheet": {
      "get": {
        "operationId": "sheet",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "itemID",
              "pattern": "^(?:[0-9a-f]{8})$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "A file"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "Key": [
              "items:read"
            ]
          }
        ],
        "summary": "Sheet renders the data sheet of an item as PDF."
      }
    },
    "/api/settings": {
      "put": {
        "operationId": "replaceSettings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Settings"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "Session": [
              "admin"
            ]
          }
        ],
        "summary": "ReplaceSettings replaces the shop's settings."
      }
    },
    "/api/stock/{kind}/{n}": {
      "get": {
        "operationId": "stockOf",
        "parameters": [
          {
            "in": "path",
            "name": "kind",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Kind"
            }
          },
          {
            "in": "path",
            "name": "n",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "format": "int64",
                  "type": "integer"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "Session": [
              "stock:read"
            ]
          },
          {
            "Key": [
              "stock:read"
            ]
          }
        ],
        "summary": "StockOf returns how many items of a kind lie on shelf n."
      }
    },
    "/assets/{path}": {
      "get": {
        "operationId": "serveAsset",
        "parameters": [
          {
            "in": "path",
            "name": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "A file"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [],
        "summary": "ServeAsset serves a static file below /assets/."
      }
    }
  }
}
