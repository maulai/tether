{
  "components": {
    "responses": {
      "BadRequest": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "The request body could not be read."
      },
      "Error": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Any other error."
      },
      "Invalid": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "The input failed validation; errors names the fields."
      }
    },
    "schemas": {
      "FieldError": {
        "properties": {
          "field": {
            "description": "Path in the input, with dots and indices: items.2.sku.",
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "rule": {
            "description": "The rule that failed; missing for errors written by a handler.",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "type": "object"
      },
      "Item": {
        "description": "Item is what the API returns.",
        "properties": {
          "attrs": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "big": {
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "data": {},
          "id": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/Kind"
          },
          "price": {
            "type": "number"
          },
          "stock": {
            "format": "int32",
            "type": "integer"
          },
          "updated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "price",
          "stock",
          "big",
          "attrs",
          "created_at"
        ],
        "type": "object"
      },
      "ItemInput": {
        "additionalProperties": false,
        "description": "ItemInput creates an item.",
        "properties": {
          "contact": {
            "additionalProperties": false,
            "properties": {
              "email": {
                "format": "email",
                "type": "string"
              },
              "site": {
                "format": "uri",
                "type": "string"
              }
            },
            "type": "object"
          },
          "count": {
            "maximum": 100,
            "type": "integer"
          },
          "ean": {
            "description": "The server also checks it with the rule ean13.",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/Kind",
            "minLength": 1,
            "pattern": "\\S"
          },
          "labels": {
            "additionalProperties": {
              "maxLength": 40,
              "type": "string"
            },
            "type": "object"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/Line"
            },
            "minItems": 1,
            "type": "array"
          },
          "price": {
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Required when kind is product."
          },
          "size": {
            "enum": [
              "s",
              "m",
              "l"
            ],
            "type": "string"
          },
          "sku": {
            "description": "SKU identifies the item.",
            "examples": [
              "ABC-1234"
            ],
            "minLength": 1,
            "pattern": "^(?:[A-Z]{3}-[0-9]{4})$",
            "type": "string"
          },
          "stock": {
            "additionalProperties": {
              "format": "int64",
              "type": "integer"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/Kind"
            },
            "type": "object"
          }
        },
        "required": [
          "sku",
          "kind"
        ],
        "type": "object"
      },
      "Kind": {
        "description": "Kind is the kind of an item.",
        "enum": [
          "",
          "product",
          "service"
        ],
        "type": "string"
      },
      "Line": {
        "additionalProperties": false,
        "description": "Line is one line of an item.",
        "properties": {
          "child": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Line"
              },
              {
                "type": "null"
              }
            ]
          },
          "qty": {
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "text": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "type": "object"
      },
      "Page_Item": {
        "description": "Page is one page of a list.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "type": "array"
          },
          "total": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total"
        ],
        "type": "object"
      },
      "Problem": {
        "description": "RFC 9457 problem details.",
        "properties": {
          "detail": {
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Features",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/items": {
      "get": {
        "operationId": "list",
        "parameters": [
          {
            "in": "query",
            "name": "kind",
            "schema": {
              "$ref": "#/components/schemas/Kind"
            }
          },
          {
            "in": "query",
            "name": "tags",
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "since",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "anyOf": [
                {
                  "format": "int64",
                  "maximum": 100,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_Item"
                }
              }
            },
            "description": "OK"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "List returns a page of items."
      },
      "post": {
        "operationId": "createItem",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ItemInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/Item"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "description": "Created"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "CreateItem adds an item."
      }
    },
    "/api/items/{id}/archive": {
      "patch": {
        "operationId": "archive",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "Archive archives an item."
      }
    },
    "/api/items/{id}/image": {
      "post": {
        "operationId": "uploadImage",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file": {
                    "format": "binary",
                    "type": "string"
                  }
                },
                "required": [
                  "file"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            },
            "description": "Created"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "UploadImage stores an image for an item."
      }
    },
    "/api/items/{id}/sheet": {
      "get": {
        "operationId": "sheet",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "A file"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "Sheet renders the data sheet of an item as PDF."
      }
    },
    "/assets/{path}": {
      "get": {
        "operationId": "serveAsset",
        "parameters": [
          {
            "in": "path",
            "name": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "A file"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "ServeAsset serves a static file below /assets/."
      }
    }
  }
}
