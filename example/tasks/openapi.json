{
  "components": {
    "responses": {
      "BadRequest": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "The request body could not be read."
      },
      "Error": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Any other error."
      },
      "Invalid": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "The input failed validation; errors names the fields."
      }
    },
    "schemas": {
      "FieldError": {
        "properties": {
          "field": {
            "description": "Path in the input, with dots and indices: items.2.sku.",
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "rule": {
            "description": "The rule that failed; missing for errors written by a handler.",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "type": "object"
      },
      "Problem": {
        "description": "RFC 9457 problem details.",
        "properties": {
          "detail": {
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "type": "object"
      },
      "Status": {
        "description": "Status is where a task stands.",
        "enum": [
          "open",
          "blocked",
          "done"
        ],
        "type": "string"
      },
      "Task": {
        "description": "Task is a task as the API returns it.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "due": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "type": "string"
          },
          "reason": {
            "description": "Reason says why a blocked task cannot go on.",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": {
            "description": "Title is a short, unique name.",
            "examples": [
              "Write the README"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "reason",
          "due",
          "tags",
          "created_at"
        ],
        "type": "object"
      },
      "TaskInput": {
        "additionalProperties": false,
        "description": "TaskInput is what a form sends to create or change a task.",
        "properties": {
          "due": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "description": "Reason says why a blocked task cannot go on. Required when status is blocked.",
            "maxLength": 500,
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/Status",
            "minLength": 1,
            "pattern": "\\S"
          },
          "tags": {
            "items": {
              "maxLength": 30,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "maxItems": 5,
            "type": "array"
          },
          "title": {
            "description": "Title is a short, unique name.",
            "examples": [
              "Write the README"
            ],
            "maxLength": 120,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Tasks",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/tasks": {
      "get": {
        "operationId": "listTasks",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "schema": {
              "$ref": "#/components/schemas/Status"
            }
          },
          {
            "in": "query",
            "name": "tag",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Task"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "ListTasks returns the tasks, oldest first."
      },
      "post": {
        "operationId": "createTask",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            },
            "description": "Created"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "CreateTask adds a task."
      }
    },
    "/v1/tasks.csv": {
      "get": {
        "operationId": "exportTasks",
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "A file"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "ExportTasks returns all tasks as CSV."
      }
    },
    "/v1/tasks/{id}": {
      "delete": {
        "operationId": "deleteTask",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "DeleteTask removes a task."
      },
      "get": {
        "operationId": "getTask",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            },
            "description": "OK"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "GetTask returns one task."
      },
      "put": {
        "operationId": "updateTask",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "UpdateTask replaces a task's fields."
      }
    }
  }
}
