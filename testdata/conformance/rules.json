    { "name": "forbiddenif on a plain number", "fields": [{ "name": "kind", "type": "string", "tag": "" }, { "name": "fee", "type": "float64", "tag": "forbiddenif=kind:!payout" }], "input": { "kind": "sale", "fee": 2 }, "errors": [{ "field": "fee", "rule": "forbiddenif" }] },
    { "name": "forbiddenif on a plain number at zero", "fields": [{ "name": "kind", "type": "string", "tag": "" }, { "name": "fee", "type": "float64", "tag": "forbiddenif=kind:!payout" }], "input": { "kind": "sale", "fee": 0 }, "errors": [] },
    { "name": "forbiddenif on a missing plain number", "fields": [{ "name": "kind", "type": "string", "tag": "" }, { "name": "fee", "type": "float64", "tag": "forbiddenif=kind:!payout" }], "input": { "kind": "sale" }, "errors": [] },
    { "name": "forbiddenif on a plain boolean", "fields": [{ "name": "kind", "type": "string", "tag": "" }, { "name": "express", "type": "bool", "tag": "forbiddenif=kind:pickup" }], "input": { "kind": "pickup", "express": true }, "errors": [{ "field": "express", "rule": "forbiddenif" }] },
    { "name": "condition on an empty plain number", "fields": [{ "name": "count", "type": "int", "tag": "" }, { "name": "note", "type": "string", "tag": "requiredif=count:" }], "input": {}, "errors": [{ "field": "note", "rule": "requiredif" }] },
    { "name": "condition on a pointer number set to zero", "fields": [{ "name": "count", "type": "*int", "tag": "" }, { "name": "note", "type": "string", "tag": "requiredif=count:" }], "input": { "count": 0 }, "errors": [] },

    { "name": "unique strings", "fields": [{ "name": "tags", "type": "[]string", "tag": "unique" }], "input": { "tags": ["a", "b", "a", "a"] }, "errors": [{ "field": "tags.2", "rule": "unique", "message": "Already in the list." }, { "field": "tags.3", "rule": "unique" }] },
    { "name": "unique is exact", "fields": [{ "name": "tags", "type": "[]string", "tag": "unique" }], "input": { "tags": ["a", "A", "a "] }, "errors": [] },
    { "name": "unique compares empty elements", "fields": [{ "name": "tags", "type": "[]string", "tag": "unique" }], "input": { "tags": ["", ""] }, "errors": [{ "field": "tags.1", "rule": "unique" }] },
    { "name": "unique compares null elements", "fields": [{ "name": "tags", "type": "[]*string", "tag": "unique" }], "input": { "tags": [null, "a", null] }, "errors": [{ "field": "tags.2", "rule": "unique" }] },
    { "name": "unique numbers", "fields": [{ "name": "nums", "type": "[]int", "tag": "unique" }], "input": { "nums": [1, 2, 1] }, "errors": [{ "field": "nums.2", "rule": "unique" }] },
    { "name": "unique enums", "fields": [{ "name": "colors", "type": "[]color", "tag": "unique" }], "input": { "colors": ["red", "blue", "red"] }, "errors": [{ "field": "colors.2", "rule": "unique" }] },
    { "name": "unique by a field", "fields": [{ "name": "items", "type": "[]object", "tag": "unique=sku", "fields": [{ "name": "sku", "type": "string", "tag": "" }] }], "input": { "items": [{ "sku": "a" }, { "sku": "b" }, { "sku": "a" }] }, "errors": [{ "field": "items.2.sku", "rule": "unique" }] },
    { "name": "unique by a field skips what is not given", "fields": [{ "name": "items", "type": "[]object", "tag": "unique=sku", "fields": [{ "name": "sku", "type": "string", "tag": "" }] }], "input": { "items": [{ "sku": "" }, {}] }, "errors": [] },
    { "name": "unique by a nested field", "fields": [{ "name": "items", "type": "[]object", "tag": "unique=ref.code", "fields": [{ "name": "ref", "type": "object", "tag": "", "fields": [{ "name": "code", "type": "string", "tag": "" }] }] }], "input": { "items": [{ "ref": { "code": "x" } }, { "ref": { "code": "x" } }] }, "errors": [{ "field": "items.1.ref.code", "rule": "unique" }] },
    { "name": "unique before the elements", "fields": [{ "name": "items", "type": "[]object", "tag": "unique=sku", "fields": [{ "name": "sku", "type": "string", "tag": "max=1" }] }], "input": { "items": [{ "sku": "ab" }, { "sku": "ab" }] }, "errors": [{ "field": "items.1.sku", "rule": "unique" }] },
    { "name": "unique after the list rules before it", "fields": [{ "name": "tags", "type": "[]string", "tag": "min=3,unique" }], "input": { "tags": ["a", "a"] }, "errors": [{ "field": "tags", "rule": "minItems" }] },

    { "name": "requiredkeys missing key", "fields": [{ "name": "text", "type": "map[string]string", "tag": "requiredkeys=de en" }], "input": { "text": { "en": "x" } }, "errors": [{ "field": "text.de", "rule": "required", "message": "Required." }] },
    { "name": "requiredkeys blank value", "fields": [{ "name": "text", "type": "map[string]string", "tag": "requiredkeys=de en" }], "input": { "text": { "de": " ", "en": "x" } }, "errors": [{ "field": "text.de", "rule": "required" }] },
    { "name": "requiredkeys missing map", "fields": [{ "name": "text", "type": "map[string]string", "tag": "requiredkeys=de en" }], "input": {}, "errors": [{ "field": "text.de", "rule": "required" }, { "field": "text.en", "rule": "required" }] },
    { "name": "requiredkeys present", "fields": [{ "name": "text", "type": "map[string]string", "tag": "requiredkeys=de en" }], "input": { "text": { "de": "a", "en": "b", "fr": "" } }, "errors": [] },
    { "name": "requiredkeys number zero has content", "fields": [{ "name": "stock", "type": "map[string]int", "tag": "requiredkeys=a" }], "input": { "stock": { "a": 0 } }, "errors": [] },
    { "name": "requiredkeys before the values", "fields": [{ "name": "text", "type": "map[string]string", "tag": "requiredkeys=de,dive,max=1" }], "input": { "text": { "en": "xyz" } }, "errors": [{ "field": "text.de", "rule": "required" }] },
    { "name": "requiredkeys reads own keys only", "fields": [{ "name": "text", "type": "map[string]string", "tag": "requiredkeys=toString" }], "input": { "text": {} }, "errors": [{ "field": "text.toString", "rule": "required" }] },

    { "name": "condition on a nested field", "fields": [{ "name": "target", "type": "object", "tag": "", "fields": [{ "name": "purpose", "type": "string", "tag": "" }] }, { "name": "note", "type": "string", "tag": "requiredif=target.purpose:loan" }], "input": { "target": { "purpose": "loan" } }, "errors": [{ "field": "note", "rule": "requiredif" }] },
    { "name": "condition through a missing struct is empty", "fields": [{ "name": "target", "type": "*object", "tag": "", "fields": [{ "name": "purpose", "type": "string", "tag": "" }] }, { "name": "note", "type": "string", "tag": "requiredif=target.purpose:" }], "input": {}, "errors": [{ "field": "note", "rule": "requiredif" }] },
    { "name": "condition through a missing struct has no value", "fields": [{ "name": "target", "type": "*object", "tag": "", "fields": [{ "name": "purpose", "type": "string", "tag": "" }] }, { "name": "note", "type": "string", "tag": "forbiddenif=target.purpose:loan" }], "input": { "note": "x" }, "errors": [] },
    { "name": "condition on a nested plain zero", "fields": [{ "name": "target", "type": "object", "tag": "", "fields": [{ "name": "n", "type": "int", "tag": "" }] }, { "name": "note", "type": "string", "tag": "requiredif=target.n:0" }], "input": {}, "errors": [{ "field": "note", "rule": "requiredif" }] },

    { "name": "minfield on times", "fields": [{ "name": "from", "type": "time", "tag": "" }, { "name": "to", "type": "time", "tag": "minfield=from" }], "input": { "from": "2026-11-10", "to": "2026-11-09" }, "errors": [{ "field": "to", "rule": "minfield", "message": "Must not be less than the start of the range." }] },
    { "name": "minfield allows equal", "fields": [{ "name": "from", "type": "time", "tag": "" }, { "name": "to", "type": "time", "tag": "minfield=from" }], "input": { "from": "2026-11-10", "to": "2026-11-10T00:00:00Z" }, "errors": [] },
    { "name": "gtfield rejects equal", "fields": [{ "name": "from", "type": "time", "tag": "" }, { "name": "to", "type": "time", "tag": "gtfield=from" }], "input": { "from": "2026-11-10", "to": "2026-11-10" }, "errors": [{ "field": "to", "rule": "gtfield" }] },
    { "name": "times compare to the millisecond", "fields": [{ "name": "from", "type": "time", "tag": "" }, { "name": "to", "type": "time", "tag": "minfield=from" }], "input": { "from": "2026-11-10T10:00:00.0009Z", "to": "2026-11-10T10:00:00Z" }, "errors": [] },
    { "name": "milliseconds count", "fields": [{ "name": "from", "type": "time", "tag": "" }, { "name": "to", "type": "time", "tag": "minfield=from" }], "input": { "from": "2026-11-10T10:00:00.001Z", "to": "2026-11-10T10:00:00.0009Z" }, "errors": [{ "field": "to", "rule": "minfield" }] },
    { "name": "times compare across offsets", "fields": [{ "name": "from", "type": "time", "tag": "" }, { "name": "to", "type": "time", "tag": "minfield=from" }], "input": { "from": "2026-11-10T10:00:00+01:00", "to": "2026-11-10T09:30:00Z" }, "errors": [] },
    { "name": "maxfield on numbers", "fields": [{ "name": "low", "type": "int", "tag": "maxfield=high" }, { "name": "high", "type": "int", "tag": "" }], "input": { "low": 5, "high": 3 }, "errors": [{ "field": "low", "rule": "maxfield", "message": "Must not be greater than the end of the range." }] },
    { "name": "ltfield across number kinds", "fields": [{ "name": "low", "type": "float64", "tag": "ltfield=high" }, { "name": "high", "type": "int", "tag": "" }], "input": { "low": 2.5, "high": 3 }, "errors": [] },
    { "name": "comparison with a plain zero bound", "fields": [{ "name": "low", "type": "int", "tag": "gtfield=high" }, { "name": "high", "type": "int", "tag": "" }], "input": { "low": -1 }, "errors": [{ "field": "low", "rule": "gtfield" }] },
    { "name": "comparison with a bound not given", "fields": [{ "name": "from", "type": "*time", "tag": "" }, { "name": "to", "type": "time", "tag": "minfield=from" }], "input": { "to": "2026-01-01" }, "errors": [] },
    { "name": "comparison with an empty time bound", "fields": [{ "name": "from", "type": "time", "tag": "" }, { "name": "to", "type": "time", "tag": "minfield=from" }], "input": { "from": "", "to": "2026-01-01" }, "errors": [] },
    { "name": "comparison skips a value not given", "fields": [{ "name": "from", "type": "time", "tag": "" }, { "name": "to", "type": "time", "tag": "minfield=from" }], "input": { "from": "2026-01-01" }, "errors": [] },
    { "name": "comparison with a nested bound", "fields": [{ "name": "period", "type": "object", "tag": "", "fields": [{ "name": "start", "type": "time", "tag": "" }] }, { "name": "end", "type": "time", "tag": "minfield=period.start" }], "input": { "period": { "start": "2026-02-01" }, "end": "2026-01-01" }, "errors": [{ "field": "end", "rule": "minfield" }] }
  ]
}
