{
  "patterns": {
    "hexColor": { "go": "#[0-9a-fA-F]{6}", "js": "#[0-9A-Fa-f]{6}" },
    "code": { "go": "(?i)ab\\d", "js": "[Aa][Bb][0-9]" }
  },
  "checks": ["even"],
  "cases": [
    { "name": "required string missing", "fields": [{ "name": "title", "type": "string", "tag": "required" }], "input": {}, "errors": [{ "field": "title", "rule": "required" }] },
    { "name": "required string empty", "fields": [{ "name": "title", "type": "string", "tag": "required" }], "input": { "title": "" }, "errors": [{ "field": "title", "rule": "required" }] },
    { "name": "required string null", "fields": [{ "name": "title", "type": "string", "tag": "required" }], "input": { "title": null }, "errors": [{ "field": "title", "rule": "required" }] },
    { "name": "required string only whitespace", "fields": [{ "name": "title", "type": "string", "tag": "required" }], "input": { "title": " \t\n " }, "errors": [{ "field": "title", "rule": "required" }] },
    { "name": "no-break space counts as whitespace", "fields": [{ "name": "title", "type": "string", "tag": "required" }], "input": { "title": " 　" }, "errors": [{ "field": "title", "rule": "required" }] },
    { "name": "byte order mark is not whitespace", "fields": [{ "name": "title", "type": "string", "tag": "required" }], "input": { "title": "﻿" }, "errors": [] },
    { "name": "required string present", "fields": [{ "name": "title", "type": "string", "tag": "required" }], "input": { "title": "x" }, "errors": [] },
    { "name": "required pointer number zero is present", "fields": [{ "name": "count", "type": "*int", "tag": "required" }], "input": { "count": 0 }, "errors": [] },
    { "name": "required pointer number missing", "fields": [{ "name": "count", "type": "*int", "tag": "required" }], "input": {}, "errors": [{ "field": "count", "rule": "required" }] },
    { "name": "required pointer number empty string", "fields": [{ "name": "count", "type": "*int", "tag": "required" }], "input": { "count": "" }, "errors": [{ "field": "count", "rule": "required" }] },
    { "name": "required list empty", "fields": [{ "name": "tags", "type": "[]string", "tag": "required" }], "input": { "tags": [] }, "errors": [{ "field": "tags", "rule": "required" }] },
    { "name": "required time empty string", "fields": [{ "name": "due", "type": "time", "tag": "required" }], "input": { "due": "" }, "errors": [{ "field": "due", "rule": "required" }] },
    { "name": "required time zero value", "fields": [{ "name": "due", "type": "time", "tag": "required" }], "input": { "due": "0001-01-01T00:00:00Z" }, "errors": [{ "field": "due", "rule": "required" }] },

    { "name": "missing number is zero", "fields": [{ "name": "qty", "type": "int", "tag": "min=1" }], "input": {}, "errors": [{ "field": "qty", "rule": "min" }] },
    { "name": "empty string for a number is zero", "fields": [{ "name": "qty", "type": "int", "tag": "min=1" }], "input": { "qty": "" }, "errors": [{ "field": "qty", "rule": "min" }] },
    { "name": "missing boolean is false", "fields": [{ "name": "on", "type": "bool", "tag": "" }], "input": {}, "errors": [] },

    { "name": "optional email empty", "fields": [{ "name": "mail", "type": "string", "tag": "email" }], "input": { "mail": "" }, "errors": [] },
    { "name": "optional email blank is checked", "fields": [{ "name": "mail", "type": "string", "tag": "email" }], "input": { "mail": " " }, "errors": [{ "field": "mail", "rule": "email" }] },
    { "name": "email valid", "fields": [{ "name": "mail", "type": "string", "tag": "email" }], "input": { "mail": "a.b@example.co.uk" }, "errors": [] },
    { "name": "email without dot", "fields": [{ "name": "mail", "type": "string", "tag": "email" }], "input": { "mail": "a@b" }, "errors": [{ "field": "mail", "rule": "email" }] },
    { "name": "email with space", "fields": [{ "name": "mail", "type": "string", "tag": "email" }], "input": { "mail": "a b@c.de" }, "errors": [{ "field": "mail", "rule": "email" }] },
    { "name": "email with no-break space is allowed", "fields": [{ "name": "mail", "type": "string", "tag": "email" }], "input": { "mail": "a b@c.de" }, "errors": [] },

    { "name": "url valid", "fields": [{ "name": "site", "type": "string", "tag": "url" }], "input": { "site": "https://example.com/a?b=c" }, "errors": [] },
    { "name": "url upper case scheme", "fields": [{ "name": "site", "type": "string", "tag": "url" }], "input": { "site": "HTTP://EXAMPLE.COM" }, "errors": [] },
    { "name": "url other scheme", "fields": [{ "name": "site", "type": "string", "tag": "url" }], "input": { "site": "javascript:alert(1)" }, "errors": [{ "field": "site", "rule": "url" }] },
    { "name": "url without host", "fields": [{ "name": "site", "type": "string", "tag": "url" }], "input": { "site": "https://" }, "errors": [{ "field": "site", "rule": "url" }] },

    { "name": "max counts characters", "fields": [{ "name": "name", "type": "string", "tag": "max=3" }], "input": { "name": "äöü" }, "errors": [] },
    { "name": "max counts code points", "fields": [{ "name": "name", "type": "string", "tag": "max=3" }], "input": { "name": "👍👍👍" }, "errors": [] },
    { "name": "max on a joined emoji", "fields": [{ "name": "name", "type": "string", "tag": "max=3" }], "input": { "name": "👨‍👩‍👧" }, "errors": [{ "field": "name", "rule": "maxLength" }] },
    { "name": "min on text", "fields": [{ "name": "name", "type": "string", "tag": "min=2" }], "input": { "name": "a" }, "errors": [{ "field": "name", "rule": "minLength" }] },
    { "name": "min skips an empty optional text", "fields": [{ "name": "name", "type": "string", "tag": "min=2" }], "input": { "name": "" }, "errors": [] },
    { "name": "min on a number", "fields": [{ "name": "qty", "type": "int", "tag": "min=1,max=10" }], "input": { "qty": 11 }, "errors": [{ "field": "qty", "rule": "max" }] },
    { "name": "gt on a number", "fields": [{ "name": "price", "type": "float64", "tag": "gt=0" }], "input": { "price": 0 }, "errors": [{ "field": "price", "rule": "gt" }] },
    { "name": "gt on a fraction", "fields": [{ "name": "price", "type": "float64", "tag": "gt=0" }], "input": { "price": 0.5 }, "errors": [] },
    { "name": "lt is exclusive", "fields": [{ "name": "rate", "type": "float64", "tag": "lt=1" }], "input": { "rate": 1 }, "errors": [{ "field": "rate", "rule": "lt" }] },
    { "name": "min on a list", "fields": [{ "name": "tags", "type": "[]string", "tag": "min=2" }], "input": { "tags": ["a"] }, "errors": [{ "field": "tags", "rule": "minItems" }] },

    { "name": "fraction for an integer", "fields": [{ "name": "qty", "type": "int", "tag": "" }], "input": { "qty": 1.5 }, "errors": [{ "field": "qty", "rule": "integer" }] },
    { "name": "text for a number", "fields": [{ "name": "qty", "type": "int", "tag": "" }], "input": { "qty": "3" }, "errors": [{ "field": "qty", "rule": "type" }] },
    { "name": "out of range for int8", "fields": [{ "name": "small", "type": "int8", "tag": "" }], "input": { "small": 300 }, "errors": [{ "field": "small", "rule": "type" }] },
    { "name": "negative for uint", "fields": [{ "name": "count", "type": "uint", "tag": "" }], "input": { "count": -1 }, "errors": [{ "field": "count", "rule": "type" }] },
    { "name": "text for a boolean", "fields": [{ "name": "on", "type": "bool", "tag": "" }], "input": { "on": "true" }, "errors": [{ "field": "on", "rule": "type" }] },
    { "name": "number for a text", "fields": [{ "name": "name", "type": "string", "tag": "" }], "input": { "name": 5 }, "errors": [{ "field": "name", "rule": "type" }] },
    { "name": "object for a list", "fields": [{ "name": "tags", "type": "[]string", "tag": "" }], "input": { "tags": {} }, "errors": [{ "field": "tags", "rule": "type" }] },
    { "name": "unknown field", "fields": [{ "name": "name", "type": "string", "tag": "" }], "input": { "name": "x", "nmae": "y" }, "errors": [{ "field": "nmae", "rule": "unknown" }], "browser": [] },

    { "name": "date only", "fields": [{ "name": "due", "type": "time", "tag": "" }], "input": { "due": "2026-11-01" }, "errors": [] },
    { "name": "date and time", "fields": [{ "name": "due", "type": "time", "tag": "" }], "input": { "due": "2026-11-01T10:30:00+01:00" }, "errors": [] },
    { "name": "impossible date", "fields": [{ "name": "due", "type": "time", "tag": "" }], "input": { "due": "2026-13-01" }, "errors": [{ "field": "due", "rule": "type" }] },
    { "name": "date with a space", "fields": [{ "name": "due", "type": "time", "tag": "" }], "input": { "due": "2026-11-01 10:30" }, "errors": [{ "field": "due", "rule": "type" }] },

    { "name": "nested field", "fields": [{ "name": "owner", "type": "object", "tag": "", "fields": [{ "name": "name", "type": "string", "tag": "required" }] }], "input": { "owner": { "name": "" } }, "errors": [{ "field": "owner.name", "rule": "required" }] },
    { "name": "nested unknown field", "fields": [{ "name": "owner", "type": "object", "tag": "", "fields": [{ "name": "name", "type": "string", "tag": "" }] }], "input": { "owner": { "nam": "x" } }, "errors": [{ "field": "owner.nam", "rule": "unknown" }], "browser": [] },
    { "name": "list of objects", "fields": [{ "name": "items", "type": "[]object", "tag": "", "fields": [{ "name": "sku", "type": "string", "tag": "required" }] }], "input": { "items": [{ "sku": "a" }, { "sku": "" }] }, "errors": [{ "field": "items.1.sku", "rule": "required" }] },
    { "name": "dive rules on elements", "fields": [{ "name": "tags", "type": "[]string", "tag": "min=1,dive,required,max=3" }], "input": { "tags": ["ok", "", "toolong"] }, "errors": [{ "field": "tags.1", "rule": "required" }, { "field": "tags.2", "rule": "maxLength" }] },
    { "name": "dive applies to empty elements", "fields": [{ "name": "tags", "type": "[]string", "tag": "dive,min=2" }], "input": { "tags": [""] }, "errors": [{ "field": "tags.0", "rule": "minLength" }] },
    { "name": "list rule before elements", "fields": [{ "name": "tags", "type": "[]string", "tag": "min=2,dive,max=1" }], "input": { "tags": ["ab"] }, "errors": [{ "field": "tags", "rule": "minItems" }] },
    { "name": "min skips an empty optional list", "fields": [{ "name": "tags", "type": "[]string", "tag": "min=1" }], "input": { "tags": [] }, "errors": [] },
    { "name": "map values", "fields": [{ "name": "labels", "type": "map[string]string", "tag": "dive,max=2" }], "input": { "labels": { "de": "abc", "en": "ab" } }, "errors": [{ "field": "labels.de", "rule": "maxLength" }] },

    { "name": "enum value", "fields": [{ "name": "color", "type": "color", "tag": "" }], "input": { "color": "red" }, "errors": [] },
    { "name": "enum unknown value", "fields": [{ "name": "color", "type": "color", "tag": "" }], "input": { "color": "purple" }, "errors": [{ "field": "color", "rule": "enum" }] },
    { "name": "optional enum empty", "fields": [{ "name": "color", "type": "color", "tag": "" }], "input": { "color": "" }, "errors": [] },
    { "name": "required enum empty", "fields": [{ "name": "color", "type": "color", "tag": "required" }], "input": { "color": "" }, "errors": [{ "field": "color", "rule": "required" }] },
    { "name": "enum element empty", "fields": [{ "name": "colors", "type": "[]color", "tag": "" }], "input": { "colors": ["red", ""] }, "errors": [{ "field": "colors.1", "rule": "enum" }] },
    { "name": "oneof", "fields": [{ "name": "size", "type": "string", "tag": "oneof=s m l" }], "input": { "size": "xl" }, "errors": [{ "field": "size", "rule": "oneof" }] },
    { "name": "oneof on an enum", "fields": [{ "name": "color", "type": "color", "tag": "oneof=red green" }], "input": { "color": "blue" }, "errors": [{ "field": "color", "rule": "oneof" }] },

    { "name": "text rejects NUL", "fields": [{ "name": "note", "type": "string", "tag": "" }], "input": { "note": "a\u0000b" }, "errors": [{ "field": "note", "rule": "text" }] },
    { "name": "text rejects direction override", "fields": [{ "name": "note", "type": "string", "tag": "" }], "input": { "note": "invoice‮fdp.exe" }, "errors": [{ "field": "note", "rule": "text" }] },
    { "name": "text rejects line separator", "fields": [{ "name": "note", "type": "string", "tag": "" }], "input": { "note": "a b" }, "errors": [{ "field": "note", "rule": "text" }] },
    { "name": "text rejects C1 control", "fields": [{ "name": "note", "type": "string", "tag": "" }], "input": { "note": "a\u0085b" }, "errors": [{ "field": "note", "rule": "text" }] },
    { "name": "text allows tab and new lines", "fields": [{ "name": "note", "type": "string", "tag": "" }], "input": { "note": "a\tb\r\nc" }, "errors": [] },
    { "name": "text allows joined emoji", "fields": [{ "name": "note", "type": "string", "tag": "" }], "input": { "note": "👨‍👩‍👧 🏳️‍🌈" }, "errors": [] },
    { "name": "text allows soft hyphen and zero width non-joiner", "fields": [{ "name": "note", "type": "string", "tag": "" }], "input": { "note": "Konsignations­lager می‌خواهم" }, "errors": [] },
    { "name": "text in list elements", "fields": [{ "name": "tags", "type": "[]string", "tag": "" }], "input": { "tags": ["ok", "a\u0000"] }, "errors": [{ "field": "tags.1", "rule": "text" }] },
    { "name": "text in map keys", "fields": [{ "name": "labels", "type": "map[string]string", "tag": "" }], "input": { "labels": { "a\u0000": "x" } }, "errors": [{ "field": "labels.a\u0000", "rule": "text" }] },
    { "name": "enum map keys", "fields": [{ "name": "stock", "type": "map[color]string", "tag": "" }], "input": { "stock": { "red": "1", "pink": "2" } }, "errors": [{ "field": "stock.pink", "rule": "enum" }] },
    { "name": "bytes as base64", "fields": [{ "name": "data", "type": "[]byte", "tag": "" }], "input": { "data": "aGVsbG8=" }, "errors": [] },
    { "name": "bytes that are not base64", "fields": [{ "name": "data", "type": "[]byte", "tag": "" }], "input": { "data": "hello!" }, "errors": [{ "field": "data", "rule": "type" }] },
    { "name": "text before length", "fields": [{ "name": "note", "type": "string", "tag": "max=1" }], "input": { "note": "ab\u0000" }, "errors": [{ "field": "note", "rule": "text" }] },

    { "name": "requiredif applies", "fields": [{ "name": "kind", "type": "string", "tag": "" }, { "name": "rate", "type": "*float64", "tag": "requiredif=kind:commission" }], "input": { "kind": "commission" }, "errors": [{ "field": "rate", "rule": "requiredif" }] },
    { "name": "requiredif does not apply", "fields": [{ "name": "kind", "type": "string", "tag": "" }, { "name": "rate", "type": "*float64", "tag": "requiredif=kind:commission" }], "input": { "kind": "consignment" }, "errors": [] },
    { "name": "forbiddenif negated", "fields": [{ "name": "kind", "type": "string", "tag": "" }, { "name": "partner", "type": "string", "tag": "forbiddenif=kind:!commission" }], "input": { "kind": "consignment", "partner": "p1" }, "errors": [{ "field": "partner", "rule": "forbiddenif" }] },
    { "name": "forbiddenif negated, condition false", "fields": [{ "name": "kind", "type": "string", "tag": "" }, { "name": "partner", "type": "string", "tag": "forbiddenif=kind:!commission" }], "input": { "kind": "commission", "partner": "p1" }, "errors": [] },
    { "name": "forbiddenif accepts whitespace as empty", "fields": [{ "name": "kind", "type": "string", "tag": "" }, { "name": "partner", "type": "string", "tag": "forbiddenif=kind:consignment" }], "input": { "kind": "consignment", "partner": "  " }, "errors": [] },
    { "name": "condition on a boolean", "fields": [{ "name": "active", "type": "bool", "tag": "" }, { "name": "note", "type": "string", "tag": "requiredif=active:true" }], "input": { "active": true }, "errors": [{ "field": "note", "rule": "requiredif" }] },
    { "name": "condition on a number", "fields": [{ "name": "count", "type": "int", "tag": "" }, { "name": "note", "type": "string", "tag": "requiredif=count:2" }], "input": { "count": 2 }, "errors": [{ "field": "note", "rule": "requiredif" }] },
    { "name": "condition on emptiness", "fields": [{ "name": "kind", "type": "string", "tag": "" }, { "name": "note", "type": "string", "tag": "requiredif=kind:" }], "input": { "kind": " " }, "errors": [{ "field": "note", "rule": "requiredif" }] },
    { "name": "condition on a nil pointer, negated", "fields": [{ "name": "kind", "type": "*string", "tag": "" }, { "name": "note", "type": "string", "tag": "forbiddenif=kind:!invoice" }], "input": { "note": "x" }, "errors": [{ "field": "note", "rule": "forbiddenif" }] },

    { "name": "pattern matches", "fields": [{ "name": "color", "type": "string", "tag": "hexColor" }], "input": { "color": "#12ab3F" }, "errors": [] },
    { "name": "pattern too short", "fields": [{ "name": "color", "type": "string", "tag": "hexColor" }], "input": { "color": "#12ab3" }, "errors": [{ "field": "color", "rule": "hexColor" }] },
    { "name": "pattern must match the whole value", "fields": [{ "name": "color", "type": "string", "tag": "hexColor" }], "input": { "color": "x#123456" }, "errors": [{ "field": "color", "rule": "hexColor" }] },
    { "name": "pattern case folding", "fields": [{ "name": "code", "type": "string", "tag": "code" }], "input": { "code": "aB7" }, "errors": [] },
    { "name": "pattern skips an empty optional value", "fields": [{ "name": "color", "type": "string", "tag": "hexColor" }], "input": { "color": "" }, "errors": [] },
    { "name": "check runs on the server only", "fields": [{ "name": "code", "type": "string", "tag": "even" }], "input": { "code": "abc" }, "errors": [{ "field": "code", "rule": "even" }], "browser": [] }
  ]
}
